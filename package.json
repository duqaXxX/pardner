{
  "name": "pardner",
  "version": "0.17.0",
  "description": "A daemon that runs coding-agent sessions on your own Mac and is driven from a chat.",
  "keywords": [
    "coding-agent",
    "claude-code",
    "agent-sdk",
    "remote",
    "daemon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duqaXxX/pardner.git"
  },
  "type": "module",
  "bin": {
    "pardner": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=26.5.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:npm": "npm run prepack && node .github/scripts/npm-package.mjs",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "typecheck": "tsc --noEmit && tsc -p src/protocol/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "golden": "node test/support/write-golden.ts",
    "test": "node .github/scripts/run-tests.mjs",
    "test:linux": "bash .github/scripts/test-linux.sh",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.327",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
