# What `npm run build` writes, and the package `npm run build:npm` assembles from it.
/dist/
/build/

# Secrets. pardner reads its configuration from ~/.config/pardner/, never from
# the repository; these lines only catch a copy made here by mistake.
.env
.env.*

# Files a machine or an agent creates while working in the checkout.
.DS_Store
/.claude/settings.local.json
/.superpowers/

/node_modules/

# The tarball `npm pack` builds for the install.
/pardner-*.tgz

# SwiftPM and Xcode: the build folder holds absolute paths, per-user data the login.
.build/
xcuserdata/
*.xcuserstate
DerivedData/
.swiftpm/
